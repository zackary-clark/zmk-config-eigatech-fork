#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Sym         1
#define Num         2
#define Nav         3
#define Fun         4
#define Mouse       5
#define Button      7
#define Game        8
#define Gameplus    9

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <125>;
            global-quick-tap;
            bindings =
                <&kp>,
                <&kp>;
        };
        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&tog>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_to_base {
            timeout-ms = <50>;
            key-positions = <0 1 2 3>;
            bindings = <&to Base>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
            &kp Q       &kp W       &kp F           &kp P           &kp B           &kp J       &kp L       &kp U           &kp Y       &kp SEMICOLON
            &hm LSHFT A &hm LCTRL R &hm LALT S      &hm LGUI T      &kp G           &kp M       &hm RGUI N  &hm RALT E      &hm RCTRL I &hm RSHFT O
&kp ESCAPE  &kp Z       &kp X       &kp C           &kp D           &kp V           &kp K       &kp H       &kp COMMA       &kp DOT     &kp SLASH       &kp RET
                                    &mo_tog Num Num &kp LSHIFT      &lt Sym BSPC    &lt Nav TAB &kp SPACE   &mo_tog Fun Nav
            >;
        };

        Sym {
            label = "Sym";
            bindings = <
        &kp EXCL    &kp AT      &kp HASH    &kp DOLLAR  &kp PERCENT &kp CARET   &kp AMPERSAND   &kp KP_ASTERISK &kp LPAR    &kp RPAR
        &kp LSHFT   &kp LCTRL   &kp LALT    &kp LGUI    &trans      &kp GRAVE   &kp SQT         &kp SEMICOLON   &kp LBKT    &kp RBKT
&trans  &trans      &trans      &trans      &trans      &trans      &kp MINUS   &kp EQUAL       &kp LT          &kp GT      &kp BSLH  &trans
                                &trans      &trans      &trans      &trans      &trans          &trans
            >;
        };

        Num {
            label = "Num";
            bindings = <
        &trans      &trans      &trans      &trans      &trans      &kp COMMA   &kp N7      &kp N8      &kp N9  &kp AMPERSAND
        &kp LSHFT   &kp LCTRL   &kp LALT    &kp LGUI    &trans      &kp DOT     &kp N4      &kp N5      &kp N6  &kp N0
&trans  &trans      &trans      &trans      &trans      &trans      &kp UNDER   &kp N1      &kp N2      &kp N3  &kp SLASH       &kp RET
                                &trans      &trans      &trans      &trans      &trans      &trans
            >;
        };

        Nav {
            label = "Nav";
            bindings = <
        &trans          &kp C_PREV      &kp C_PLAY_PAUSE    &kp C_NEXT      &bt BT_NXT      &kp PG_UP   &kp HOME    &kp UP      &kp END   &trans
        &kp LSHFT       &kp LCTRL       &kp LALT            &kp LGUI        &bt BT_PRV      &kp PG_DN   &kp LEFT    &kp DOWN    &kp RIGHT &kp LCTRL
&trans  &kp C_BRI_DEC   &kp C_BRI_INC   &kp C_VOL_DN        &kp C_VOL_UP    &bt BT_CLR      &trans      &trans      &trans      &trans    &kp LS(LCTRL)     &trans
                                        &trans              &kp DEL         &trans      &trans      &trans      &trans
            >;
        };

        Fun {
            label = "Fun";
            bindings = <
        &trans      &trans      &trans      &trans      &trans  &trans  &kp F9  &kp F10 &kp F11 &kp F12
        &kp LSHFT   &kp LCTRL   &kp LALT    &kp LGUI    &trans  &trans  &kp F5  &kp F6  &kp F7  &kp F8
&trans  &trans      &trans      &trans      &trans      &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F4  &trans
                                &trans      &trans      &trans  &trans  &trans  &trans
            >;
        };

        Button {
            label = "Button";
            bindings = <
                    &bt BT_CLR    &trans     &trans      &trans  &bt BT_SEL 0      &trans            &trans      &trans  &bootloader    &trans
                      &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &bt BT_SEL 1      &trans        &kp RSHIFT   &kp RCTRL     &kp RALT  &kp RGUI
&bootloader  &ext_power EP_TOG    &trans     &trans      &trans  &bt BT_SEL 2      &trans            &trans      &trans       &trans    &trans  &trans
                                             &trans      &trans        &trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT
            >;
        };

        Gaming {
            bindings = <
            &trans  &trans     &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans
             &kp A   &kp S      &kp D         &kp F   &mo 6  &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &trans  &trans     &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                            &kp LCTRL  &kp LEFT_ALT  &trans  &trans  &trans  &trans
            >;

            label = "Gaming";
        };

        Gaming+ {
            bindings = <
         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &trans  &trans  &trans  &trans  &kp LC(RA(DEL))
                &kp L         &kp O         &kp Y         &kp K         &kp G  &kp F5  &trans  &trans  &trans           &trans
&kp TAB         &to 0        &trans        &trans  &kp NUMBER_6  &kp NUMBER_7  &trans  &trans  &trans  &trans           &trans  &kp LA(F4)
                                            &kp J         &kp I         &kp M  &trans  &trans  &trans
            >;

            label = "Gaming+";
        };
    };
};
